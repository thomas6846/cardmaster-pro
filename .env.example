# ============================================================================
# CardMaster Pro — Environment Template
# Copy this file to .env.local and fill in your credentials.
# ============================================================================

# --- Database ---------------------------------------------------------------
DATABASE_URL="file:./prisma/cardmaster.db"

# --- Anthropic Vision (card recognition) ------------------------------------
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-opus-4-7"

# --- Shopify Admin API ------------------------------------------------------
# Generate from Shopify admin → Apps → Develop apps → Admin API access token
SHOPIFY_SHOP="your-store.myshopify.com"
SHOPIFY_ADMIN_TOKEN="shpat_..."
SHOPIFY_LOCATION_ID=""
SHOPIFY_API_VERSION="2025-01"

# --- SNKRDUNK scraper -------------------------------------------------------
# The scraper itself lives in src/lib/scraper.ts (custom-built). If you need
# external config (cookies, proxy URLs, etc.) for your scraper, add the env
# vars here and read them inside src/lib/scraper.ts.
# Example placeholders — change to whatever your scraper needs:
# SNKRDUNK_PROXY_URL=""
# SNKRDUNK_COOKIE=""

# --- Market reference providers (multi-source aggregator) -------------------
# Used by /api/market-reference + scanner "查多店市場行情". Any missing → that
# source skipped silently. yuyu-tei + competitor(OCR) work with no token.
EBAY_BEARER_TOKEN=""
EBAY_MARKETPLACE_ID="EBAY_US"
SNKRDUNK_PROVIDER_URL=""
SNKRDUNK_PROVIDER_TOKEN=""
USD_TO_HKD="7.8"

# --- X (Twitter) API — auto-ingest shop buyback tables ----------------------
# X API v2 app-only bearer token (Basic tier ~$100/mo). Powers
# /api/cron/ingest-twitter which fetches monitored shops' price-list images
# and OCRs them via Claude Vision. Manage accounts at /admin/buyback-table.
X_BEARER_TOKEN=""

# --- Telegram Bot (supervisor approval push) --------------------------------
# Create with @BotFather, get chat id by messaging @userinfobot in your channel
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- App URL (used for absolute approval links sent to Telegram) ------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- FX rate fallback (JPY → HKD) when SNKRDUNK returns JPY -----------------
JPY_TO_HKD_RATE="0.0505"
