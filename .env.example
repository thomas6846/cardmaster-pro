# ============================================================================
# CardMaster Pro — Environment Template
# Copy this file to .env.local and fill in your credentials.
# ============================================================================

# --- Database ---------------------------------------------------------------
DATABASE_URL="file:./prisma/cardmaster.db"

# --- Anthropic Vision (card recognition) ------------------------------------
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-opus-4-7"

# --- Shopify Admin API ------------------------------------------------------
# Generate from Shopify admin → Apps → Develop apps → Admin API access token
SHOPIFY_SHOP="your-store.myshopify.com"
SHOPIFY_ADMIN_TOKEN="shpat_..."
SHOPIFY_LOCATION_ID=""
SHOPIFY_API_VERSION="2025-01"

# --- SNKRDUNK via ScraperAPI ------------------------------------------------
# We proxy SNKRDUNK through ScraperAPI (https://www.scraperapi.com/) because
# SNKRDUNK is CloudFront + geo-locked. Hobby plan ($49/mo) is fine for one shop.
# Leave SCRAPERAPI_KEY blank to fall back to deterministic mock prices.
SCRAPERAPI_KEY=""
SCRAPERAPI_COUNTRY="jp"

# --- Telegram Bot (supervisor approval push) --------------------------------
# Create with @BotFather, get chat id by messaging @userinfobot in your channel
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- App URL (used for absolute approval links sent to Telegram) ------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- FX rate fallback (JPY → HKD) when SNKRDUNK returns JPY -----------------
JPY_TO_HKD_RATE="0.0505"
