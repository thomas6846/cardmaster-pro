# ============================================================================
# Production env template (Railway)
# Paste each KEY=VALUE into Railway service → Variables.
# NEVER commit a filled-in copy.
# ============================================================================

# DATABASE_URL — Railway lets you reference the Postgres service:
#   In Railway UI → Variables → "+ New Variable" → "Add Reference" → Postgres.DATABASE_URL
DATABASE_URL="${{Postgres.DATABASE_URL}}"
DATABASE_DIRECT_URL="${{Postgres.DATABASE_URL}}"

# After first deploy Railway gives you a *.up.railway.app URL. Paste it here
# (Variables tab) and redeploy so callbacks resolve correctly.
AUTH_SECRET="paste-output-of-`openssl rand -base64 32`"
AUTH_URL="https://your-app.up.railway.app"
NEXT_PUBLIC_APP_URL="https://your-app.up.railway.app"

ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-opus-4-7"

SHOPIFY_SHOP="your-store.myshopify.com"
SHOPIFY_ADMIN_TOKEN="shpat_..."
SHOPIFY_LOCATION_ID="12345678"
SHOPIFY_API_VERSION="2025-01"

# Custom scraper config (see src/lib/scraper.ts). Add whatever your scraper
# implementation needs; e.g. SNKRDUNK_PROXY_URL or SNKRDUNK_COOKIE.

TELEGRAM_BOT_TOKEN="123456789:ABC..."
TELEGRAM_CHAT_ID="-1001234567890"

JPY_TO_HKD_RATE="0.0505"
NODE_ENV="production"
